{
  "name": "mdview",
  "version": "0.1.0",
  "description": "図表を描画し、図をPDF/PNGへ、表をLaTeXへ書き出せるmacOS向けMarkdownビューアー",
  "main": "./out/main/index.js",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@plantuml/core": "^1.2026.8",
    "@types/node": "^26.6.2",
    "@viz-js/viz": "^3.30.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "katex": "^0.18.7",
    "markdown-it": "^15.0.2",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-texmath": "^1.0.0",
    "mathjax-full": "^3.2.1",
    "mermaid": "^12.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "fsevents": true
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --mac --dir --arm64",
    "web:dev": "vite --config vite.config.web.ts",
    "web:build": "tsc --noEmit -p tsconfig.web.json && vite build --config vite.config.web.ts",
    "web:serve": "node tools/serve-web.mjs",
    "dist:mac": "electron-vite build && electron-builder --mac && node tools/make-release.mjs"
  },
  "build": {
    "appId": "jp.ac.chibatech.suda.mdview",
    "productName": "mdview",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown Document",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null,
      "darkModeSupport": true,
      "icon": "build/icon.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "mdview ${version}",
      "window": {
        "width": 620,
        "height": 420
      },
      "iconSize": 110,
      "contents": [
        {
          "x": 150,
          "y": 150,
          "type": "file"
        },
        {
          "x": 470,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 310,
          "y": 310,
          "type": "file",
          "path": "build/dmg/はじめにお読みください.txt"
        }
      ]
    },
    "afterPack": "./build/after-pack.cjs"
  }
}
